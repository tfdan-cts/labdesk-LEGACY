[Unit]
Description=Read-only labnet readiness probes
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
LoadCredential=backup-inventory.json:/var/lib/labnet-operations/backup-inventory.json
ExecStart=/usr/bin/python3 /opt/labnet-operations/readiness.py --config /etc/labnet-operations/readiness.json
TimeoutStartSec=55
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
StandardOutput=journal
StandardError=journal
