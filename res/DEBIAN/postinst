#!/bin/sh
set -eu

if [ "${1:-}" = configure ]; then
    ln -sfn /usr/share/labdesk/labdesk /usr/bin/labdesk
    if [ -d /run/systemd/system ]; then
        install -m 644 /usr/share/labdesk/files/systemd/labdesk.service /usr/lib/systemd/system/labdesk.service
        systemctl daemon-reload
        systemctl enable labdesk
        systemctl start labdesk
    fi
fi
